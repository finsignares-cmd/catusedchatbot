rules_version = '2';

// Least-privilege rules (spec.md NFR2).
// The Cloud Function `chat` uses the Admin SDK and is not affected by these
// rules. Clients are the FlutterFlow app (Firebase Auth users).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isFlutterFlowEditor() {
      return signedIn() &&
        request.auth.token.email == "firebase@flutterflow.io";
    }

    function ownsExisting() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsNew() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    // FlutterFlow editor account (schema browsing in the FlutterFlow editor).
    match /{document=**} {
      allow read, write: if isFlutterFlowEditor();
    }

    // Catalogue: readable by signed-in users, written only from the
    // Firebase console / Admin SDK.
    match /machines/{id} {
      allow read: if signedIn();
    }
    match /knowledge/{id} {
      allow read: if signedIn();
    }
    match /machineCategories/{id} {
      allow read: if signedIn();
    }

    // User profile: only its owner.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Chat history: each user sees and writes only their own documents,
    // and cannot hand a document over to another user.
    match /chatSessions/{sessionId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsNew();
      allow update: if ownsExisting() && ownsNew();
    }
    // Messages belong to a session. The FlutterFlow app reads them with
    // `where sessionId == X` (no userId filter) and stores the bot reply
    // itself with userId "AI", so ownership is checked through the session.
    function ownsSession(sessionId) {
      return signedIn() &&
        get(/databases/$(database)/documents/chatSessions/$(sessionId))
          .data.userId == request.auth.uid;
    }
    match /chatMessages/{messageId} {
      allow read: if ownsSession(resource.data.sessionId);
      allow create: if ownsSession(request.resource.data.sessionId) &&
        (request.resource.data.userId == request.auth.uid ||
         (request.resource.data.userId == "AI" &&
          request.resource.data.role == "ChatBot"));
      allow update, delete: if false;
    }
  }
}
